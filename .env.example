# Slack (from api.slack.com/apps, install as workspace owner)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_USER_TOKEN=xoxp-...

# OpenRouter (all model calls go through here)
OPENROUTER_API_KEY=sk-or-...
TIER1_MODEL=openai/gpt-4o-mini
TIER1_FALLBACK_MODEL=google/gemini-2.5-flash-lite

# Optional
OPENAI_API_KEY=
POLICY_FILE=policies/default.yaml
AUDIT_FILE=audit.jsonl
MANAGER_USER_IDS=U12345678,U23456789
REDACTION_RESTORE_TTL_SECONDS=900

# Durable queue
QUEUE_DB=blackline.db
WORKERS=4
DEEP_WORKERS=8

# Production
# secret for audit fingerprints; generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
AUDIT_HMAC_KEY=
PORT=8080
LOG_FORMAT=text

# Read tokens from Google Secret Manager instead of this file (leave the token lines empty)
SECRETS_PROJECT=
